class Solution {
public:
    bool isPerfectSquare(int num) {
        int start=0;
        int end=num;
        while(start<=end){
            int mid=start +(end-start)/2;
            long long new_mid=1LL*mid*mid; // for larger integer long long is for larger integer 
            if(num>new_mid){
                start=mid+1;
            }else if(num<new_mid){
                end=mid-1;
            }else{
                return true;
            }

            
        }
        return false;
    }
};
