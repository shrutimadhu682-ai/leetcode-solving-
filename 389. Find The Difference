class Solution {
public:
    char findTheDifference(string s, string t) {
        int n = s.size();
        int m = t.size();

        for (int i = 0; i < m; i++) {
            bool found = false;

            for (int j = 0; j < n; j++) {
                if (t[i] == s[j]) {
                    s[j] = '#';      // Mark the character as used
                    found = true;
                    break;
                }
            }

            if (!found)
                return t[i];
        }

        return ' ';
    }
};
