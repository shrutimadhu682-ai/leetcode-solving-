class Solution {
public:
    int totalNumbers(vector<int>& digits) {
        int n=digits.size();
        set<int>num;
        int count=0;
        for (int i=0;i<n;i++){
            for (int j=0;j<n;j++){
                for (int k=0;k<n;k++){
                    if (i==j||j==k||i==k){
                        continue;
                    }
                    if (digits[i]==0){
                        continue;
                    }
                    int val =digits[i]*100+digits[j]*10+digits[k];
                    if (val<100||val>999){
                        continue ;
                    }
                    else{
                        if (val%2!=0){
                            continue;
                        }
                        num.insert(val);
                    }
                }
            }
        }
        return num.size();
    }
};
